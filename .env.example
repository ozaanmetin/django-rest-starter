# Django Core Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/django_rest_db
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=django_rest_db
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cache Configuration
CACHE_KEY_PREFIX=django_rest


# Production Settings
# Below here are not required for development but needed for production.
# They must be configured when deploying to production.

# Security
SECURE_SSL_REDIRECT=True

# Cors Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Email (Its optional, if email is not needed, just dont set these.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@example.com
